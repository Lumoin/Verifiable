<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    
  <PropertyGroup>
    <Title>Core data types and algorithms for DIDs and VCs</Title>
    <Description>Includes and implements core data types and algorithms for decentralized identifiers and verifiable credentials.</Description>
    <PackageTags>DID VC decentralized-identifier verifiable credential signing encryption</PackageTags>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Verifiable.Foundation\Verifiable.Foundation.csproj" />
    <ProjectReference Include="..\Verifiable.JCose\Verifiable.JCose.csproj" />
    <ProjectReference Include="..\Verifiable.JsonPointer\Verifiable.JsonPointer.csproj" />
  </ItemGroup>

  <!-- The bbs-2023 Data Integrity cryptosuite consumes the BBS primitive and the managed
       BLS12-381 algebraic backends; Core is pulled transitively by both. -->
  <ItemGroup>
    <!-- The RFC 6901 JSON Pointer type consumed across Data Integrity, mdoc, DCQL, and
         selective disclosure comes from the Lumoin.Veritas family; the remaining
         Verifiable.JsonPointer project reference carries only the minimal JSONata engine. -->
    <PackageReference Include="Lumoin.Veritas.JsonPointer" />
    <PackageReference Include="Lumoin.Veridical.Bbs" />
    <PackageReference Include="Lumoin.Veridical.Backends.Managed" />
  </ItemGroup>
    
</Project>
