<Project Sdk="Microsoft.NET.Sdk">
   
  <PropertyGroup>
    <Title>CBOR serializers for COSE, CWT, mdoc and FIDO2/CTAP2.</Title>
    <Description>CBOR serializers built on Lumoin.Veritas.Cbor: COSE envelopes and keys, CWT and SD-CWT selective disclosure, ISO/IEC 18013-5 mdoc DeviceResponse, FIDO2/CTAP2 wire structures, IETF status lists and CB-AdES (ETSI TS 119 152-1) COSE_Sign1 signatures. Designed for AOT compatibility and trimming safety.</Description>
    <PackageTags>CBOR COSE CWT SD-CWT Mdoc FIDO2 CTAP2 CBAdES StatusList AOT VerifiableCredentials DataIntegrity</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verifiable.Foundation\Verifiable.Foundation.csproj" />
    <ProjectReference Include="..\Verifiable.Core\Verifiable.Core.csproj" />
    <ProjectReference Include="..\Verifiable.Fido2\Verifiable.Fido2.csproj" />
    <ProjectReference Include="..\Verifiable.JCose\Verifiable.JCose.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lumoin.Veritas.Cbor" />
  </ItemGroup>
  
</Project>
