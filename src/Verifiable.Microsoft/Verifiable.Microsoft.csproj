<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Microsoft .NET cryptographic implementation and Windows specific security functionality</Title>
    <Description>.NET cryptographic implementation and ProtectedData enhancement.</Description>
    <PackageTags>.NET cryptographic implementation and ProtectedData</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The CMS surface (SignedCms, CryptographicAttributeObject) lives in the out-of-band Pkcs
         package. This direct reference declares the dependency where it is used; it previously
         compiled only through an undeclared transitive flow from a build-task package's chain. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verifiable.Foundation\Verifiable.Foundation.csproj" />
    <ProjectReference Include="..\Verifiable.Core\Verifiable.Core.csproj" />
  </ItemGroup>
     
</Project>
