<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    
  <PropertyGroup>
    <Title>JOSE and COSE cryptographic operations and data types.</Title>
    <Description>Core data types and operations for JOSE (JSON Object Signing and Encryption) and COSE (CBOR Object Signing and Encryption) standards. Includes JWK key representations, JWS/JWE operations, SD-JWT selective disclosure, and signing infrastructure. Serialization-agnostic design enables use with JSON, CBOR, or other formats via separate serialization packages.</Description>
    <PackageTags>JOSE COSE JWK JWS JWE JWT SD-JWT Cryptography Signing Encryption VerifiableCredentials DID</PackageTags>
  </PropertyGroup>

  <PropertyGroup>    
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Verifiable.Foundation\Verifiable.Foundation.csproj" />
    <ProjectReference Include="..\Verifiable.Cryptography\Verifiable.Cryptography.csproj" />
  </ItemGroup>

  <!--
    CBAdESSign1ParseResult (CBAdESSerializationDelegates.cs) is mint-only: its constructor and
    Success/Failure factories are internal, so a "successfully parsed" result can only originate from a
    CBOR parse implementation this assembly grants access to. Verifiable.Cbor implements
    ParseCBAdESSign1Delegate (wavecb S3 stage m4) and therefore needs that access; the global
    Tests/Benchmarks grants come from the root Directory.Build.props.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Verifiable.Cbor" />
  </ItemGroup>

</Project>
